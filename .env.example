# ==============================================================================
# INTEGRATED CAMPUS MANAGEMENT SYSTEM (ICMS) - ENVIRONMENT TEMPLATE
# ==============================================================================

# Application Core
NODE_ENV=development
APP_NAME="ICMS Campus Suite"
APP_ENV=development
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
PORT=4000

# Primary Database (PostgreSQL 16+)
# Local Service or Docker Compose:
# postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icms_db?schema=public"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT Security
# Generate robust 64-char keys for production
JWT_SECRET="icms_super_secure_jwt_secret_key_change_in_production_2026_xyz"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="icms_super_secure_refresh_secret_key_change_in_production_2026_abc"
JWT_REFRESH_EXPIRES_IN="7d"

# Argon2 Password Hashing Params
ARGON_TIME_COST=3
ARGON_MEMORY_COST=65536
ARGON_PARALLELISM=4

# Object Storage (Local / S3-Compatible: MinIO, AWS S3, Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=icms-documents
S3_REGION=us-east-1

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Payment Gateway Sandbox Mode
PAYMENT_SANDBOX_MODE=true
PAYMENT_GATEWAY_API_KEY="sandbox_test_key"
PAYMENT_CALLBACK_TOKEN="sandbox_callback_verification_token"

# Frontend Vite Variables (Used during web build)
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_APP_NAME="ICMS Campus Suite"
VITE_DEFAULT_LANGUAGE="id"

