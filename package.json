{
  "name": "icms-campus-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated Campus Management System (ICMS) - Enterprise Higher Education Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "concurrently \"npm run dev -w @icms/web\" \"npm run start:dev -w @icms/api\"",
    "dev:web": "npm run dev -w @icms/web",
    "dev:api": "npm run start:dev -w @icms/api",
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w @icms/shared",
    "build:web": "npm run build -w @icms/web",
    "build:api": "npm run build -w @icms/api",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}

