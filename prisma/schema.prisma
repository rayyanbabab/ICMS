// ==============================================================================
// PRISMA SCHEMA — INTEGRATED CAMPUS MANAGEMENT SYSTEM (ICMS)
// Enterprise University Management Platform
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// 1. AUTHENTICATION & ACCESS CONTROL (RBAC)
// ==============================================================================

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  username         String         @unique
  passwordHash     String         @map("password_hash")
  fullName         String         @map("full_name")
  phoneNumber      String?        @map("phone_number")
  avatarUrl        String?        @map("avatar_url")
  isActive         Boolean        @default(true) @map("is_active")
  isVerified       Boolean        @default(false) @map("is_verified")
  mfaEnabled       Boolean        @default(false) @map("mfa_enabled")
  mfaSecret        String?        @map("mfa_secret")
  lastLoginAt      DateTime?      @map("last_login_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  userRoles        UserRoleMap[]
  sessions         UserSession[]
  loginLogs        LoginLog[]
  passwordResets   PasswordReset[]
  auditLogs        AuditLog[]
  studentProfile   Student?
  lecturerProfile  Lecturer?
  employeeProfile  Employee?
  libraryMember    LibraryMember?
  notifications    Notification[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")

  @@map("users")
}

model Role {
  id          String         @id @default(uuid())
  code        String         @unique // e.g., 'SUPER_ADMIN', 'RECTOR', 'DEAN', 'STUDENT'
  name        String
  description String?
  isSystem    Boolean        @default(false) @map("is_system")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  userRoles   UserRoleMap[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  module      String           // e.g., 'ACADEMIC', 'STUDENT', 'FINANCE'
  action      String           // e.g., 'CREATE', 'READ', 'UPDATE', 'DELETE', 'APPROVE'
  code        String           @unique // e.g., 'ACADEMIC:READ', 'FINANCE:APPROVE'
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  roles       RolePermission[]

  @@map("permissions")
}

model UserRoleMap {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  roleId         String    @map("role_id")
  facultyId      String?   @map("faculty_id")       // Role scope limit (optional)
  studyProgramId String?   @map("study_program_id") // Role scope limit (optional)
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, facultyId, studyProgramId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  isRevoked    Boolean   @default(false) @map("is_revoked")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  status    String   // SUCCESS, FAILED
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_logs")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  isUsed    Boolean   @default(false) @map("is_used")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ==============================================================================
// 2. UNIVERSITY ORGANIZATIONAL STRUCTURE
// ==============================================================================

model University {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  legalName   String?   @map("legal_name")
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?   @map("logo_url")
  accreditation String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  campuses    Campus[]
  faculties   Faculty[]

  @@map("universities")
}

model Campus {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  code         String     @unique
  name         String
  address      String?
  city         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  classrooms   Classroom[]
  facilities   Facility[]

  @@map("campuses")
}

model Faculty {
  id           String         @id @default(uuid())
  universityId String         @map("university_id")
  code         String         @unique
  name         String
  deanName     String?        @map("dean_name")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  university   University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  studyPrograms StudyProgram[]

  @@map("faculties")
}

model StudyProgram {
  id           String     @id @default(uuid())
  facultyId    String     @map("faculty_id")
  code         String     @unique // e.g., 'IF', 'SI', 'TI'
  name         String
  degreeLevel  String     @map("degree_level") // S1, S2, D3, etc.
  headOfProgram String?   @map("head_of_program")
  accreditation String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  faculty      Faculty    @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  students     Student[]
  curricula    Curriculum[]
  lecturers    Lecturer[]

  @@map("study_programs")
}

model AcademicYear {
  id        String     @id @default(uuid())
  code      String     @unique // e.g., '2026/2027'
  name      String
  startDate DateTime   @map("start_date")
  endDate   DateTime   @map("end_date")
  isActive  Boolean    @default(false) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  semesters Semester[]

  @@map("academic_years")
}

model Semester {
  id             String       @id @default(uuid())
  academicYearId String       @map("academic_year_id")
  code           String       @unique // e.g., '2026-1', '2026-2'
  name           String       // Semester Ganjil 2026/2027
  type           String       // ODD, EVEN, SHORT
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  krsStartDate   DateTime     @map("krs_start_date")
  krsEndDate     DateTime     @map("krs_end_date")
  isActive       Boolean      @default(false) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  offerings      CourseOffering[]
  studentRegistrations StudentRegistration[]
  invoices       StudentInvoice[]

  @@map("semesters")
}

// ==============================================================================
// 3. STUDENT MANAGEMENT
// ==============================================================================

model Student {
  id             String      @id @default(uuid())
  userId         String      @unique @map("user_id")
  studyProgramId String      @map("study_program_id")
  nim            String      @unique // Nomor Induk Mahasiswa
  nisn           String?     @unique
  nik            String?     @unique
  placeOfBirth   String?     @map("place_of_birth")
  dateOfBirth    DateTime?   @map("date_of_birth")
  gender         String?     // L, P
  religion       String?
  address        String?
  entryYear      Int         @map("entry_year")
  entrySemester  String      @map("entry_semester")
  currentSemester Int        @default(1) @map("current_semester")
  status         String      @default("ACTIVE") // ACTIVE, ON_LEAVE, GRADUATED, etc.
  advisorId      String?     @map("advisor_id") // Dosen Pembimbing Akademik
  gpa            Float       @default(0.0) // IPK Kumulatif
  totalCredits   Int         @default(0)   @map("total_credits") // Total SKS Lulus
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id])
  advisor        Lecturer?   @relation("AcademicAdvisor", fields: [advisorId], references: [id])
  
  guardians      StudentGuardian[]
  documents      StudentDocument[]
  statusHistory  StudentStatusHistory[]
  registrations  StudentRegistration[]
  invoices       StudentInvoice[]
  attendanceRecords AttendanceRecord[]
  submissions    AssignmentSubmission[]
  examAttempts   ExamAttempt[]

  @@index([nim])
  @@index([studyProgramId])
  @@map("students")
}

model StudentGuardian {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  name        String
  relation    String   // FATHER, MOTHER, GUARDIAN
  phoneNumber String?  @map("phone_number")
  email       String?
  occupation  String?
  incomeRange String?  @map("income_range")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_guardians")
}

model StudentDocument {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  title      String
  type       String   // IJAZAH, KTP, KK, TRANSCRIPT, PHOTO
  fileUrl    String   @map("file_url")
  fileSize   Int      @map("file_size")
  mimeType   String   @map("mime_type")
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_documents")
}

model StudentStatusHistory {
  id         String   @id @default(uuid())
  studentId  String   @map("student_id")
  prevStatus String   @map("prev_status")
  newStatus  String   @map("new_status")
  reason     String?
  changedBy  String?  @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_status_history")
}

// ==============================================================================
// 4. LECTURER MANAGEMENT
// ==============================================================================

model Lecturer {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  studyProgramId String       @map("study_program_id")
  nidn           String?      @unique // Nomor Induk Dosen Nasional
  nip            String?      @unique
  academicRank   String?      @map("academic_rank") // Asisten Ahli, Lektor, dsb
  highestDegree  String?      @map("highest_degree") // S2, S3
  specialization String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id])

  advisees       Student[]    @relation("AcademicAdvisor")
  classes        CourseClass[]
  attendanceSessions AttendanceSession[]

  @@map("lecturers")
}

// ==============================================================================
// 5. ACADEMIC & CURRICULUM
// ==============================================================================

model Curriculum {
  id             String       @id @default(uuid())
  studyProgramId String       @map("study_program_id")
  code           String       @unique
  name           String
  year           Int
  totalCredits   Int          @map("total_credits")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  studyProgram   StudyProgram @relation(fields: [studyProgramId], references: [id])
  courses        Course[]

  @@map("curricula")
}

model Course {
  id           String       @id @default(uuid())
  curriculumId String       @map("curriculum_id")
  code         String       @unique // e.g., 'IF201'
  name         String
  englishName  String?      @map("english_name")
  credits      Int          // SKS
  semester     Int          // Rekomendasi semester (1-8)
  type         String       @default("MANDATORY") // MANDATORY, ELECTIVE
  description  String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  offerings    CourseOffering[]
  prerequisites CoursePrerequisite[] @relation("TargetCourse")
  prerequisiteFor CoursePrerequisite[] @relation("PrerequisiteCourse")

  @@map("courses")
}

model CoursePrerequisite {
  id             String   @id @default(uuid())
  courseId       String   @map("course_id")
  prerequisiteId String   @map("prerequisite_id")
  minGrade       String?  @default("D") @map("min_grade")

  course         Course   @relation("TargetCourse", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite   Course   @relation("PrerequisiteCourse", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteId])
  @@map("course_prerequisites")
}

model Classroom {
  id        String       @id @default(uuid())
  campusId  String       @map("campus_id")
  code      String       @unique
  name      String
  capacity  Int
  building  String?
  floor     Int?
  isLab     Boolean      @default(false) @map("is_lab")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  campus    Campus       @relation(fields: [campusId], references: [id])
  schedules ClassSchedule[]

  @@map("classrooms")
}

model CourseOffering {
  id         String       @id @default(uuid())
  semesterId String       @map("semester_id")
  courseId   String       @map("course_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  semester   Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classes    CourseClass[]

  @@unique([semesterId, courseId])
  @@map("course_offerings")
}

model CourseClass {
  id               String       @id @default(uuid())
  courseOfferingId String       @map("course_offering_id")
  lecturerId       String?      @map("lecturer_id")
  name             String       // e.g., 'IF-45-01'
  capacity         Int          @default(40)
  enrolledCount    Int          @default(0) @map("enrolled_count")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  offering         CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  lecturer         Lecturer?    @relation(fields: [lecturerId], references: [id])
  schedules        ClassSchedule[]
  registrationDetails StudentRegistrationDetail[]
  attendanceSessions  AttendanceSession[]
  materials        CourseMaterial[]
  assignments      Assignment[]
  exams            Exam[]

  @@map("course_classes")
}

model ClassSchedule {
  id          String      @id @default(uuid())
  classId     String      @map("class_id")
  classroomId String      @map("classroom_id")
  dayOfWeek   Int         // 1=Monday ... 7=Sunday
  startTime   String      @map("start_time") // '08:00'
  endTime     String      @map("end_time")   // '10:30'
  createdAt   DateTime    @default(now()) @map("created_at")

  class       CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  classroom   Classroom   @relation(fields: [classroomId], references: [id])

  @@map("class_schedules")
}

// ==============================================================================
// 6. KRS & KHS REGISTRATION
// ==============================================================================

model StudentRegistration {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  semesterId     String       @map("semester_id")
  status         String       @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED
  totalCredits   Int          @default(0) @map("total_credits")
  maxCredits     Int          @default(24) @map("max_credits")
  gpaPrevious    Float?       @map("gpa_previous") // IPS semester lalu
  submittedAt    DateTime?    @map("submitted_at")
  approvedAt     DateTime?    @map("approved_at")
  approvedBy     String?      @map("approved_by") // Dosen Wali
  rejectionNote  String?      @map("rejection_note")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester       Semester     @relation(fields: [semesterId], references: [id])
  details        StudentRegistrationDetail[]

  @@unique([studentId, semesterId])
  @@map("student_registrations")
}

model StudentRegistrationDetail {
  id             String              @id @default(uuid())
  registrationId String              @map("registration_id")
  classId        String              @map("class_id")
  scoreNumeric   Float?              @map("score_numeric") // 0-100
  gradeLetter    String?             @map("grade_letter")  // A, B+, B, C+, C, D, E
  gradePoint     Float?              @map("grade_point")   // 4.0, 3.5, 3.0, etc.
  isPublished    Boolean             @default(false) @map("is_published")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  registration   StudentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  class          CourseClass         @relation(fields: [classId], references: [id])

  @@unique([registrationId, classId])
  @@map("student_registration_details")
}

// ==============================================================================
// 7. ATTENDANCE MANAGEMENT
// ==============================================================================

model AttendanceSession {
  id          String       @id @default(uuid())
  classId     String       @map("class_id")
  lecturerId  String       @map("lecturer_id")
  sessionNum  Int          @map("session_num") // Pertemuan ke- (1-16)
  date        DateTime     @map("date")
  startTime   DateTime     @map("start_time")
  endTime     DateTime     @map("end_time")
  topic       String?
  qrCodeToken String?      @unique @map("qr_code_token")
  isOpen      Boolean      @default(true) @map("is_open")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  class       CourseClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  lecturer    Lecturer     @relation(fields: [lecturerId], references: [id])
  records     AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String            @id @default(uuid())
  sessionId   String            @map("session_id")
  studentId   String            @map("student_id")
  status      String            // PRESENT, LATE, SICK, PERMITTED, ABSENT
  checkInTime DateTime?         @map("check_in_time")
  latitude    Float?
  longitude   Float?
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@map("attendance_records")
}

// ==============================================================================
// 8. FINANCE & PAYMENT
// ==============================================================================

model StudentInvoice {
  id             String       @id @default(uuid())
  studentId      String       @map("student_id")
  semesterId     String       @map("semester_id")
  invoiceNumber  String       @unique @map("invoice_number") // e.g. 'INV-2026-0001'
  title          String
  amount         Decimal      @db.Decimal(12, 2)
  paidAmount     Decimal      @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  status         String       @default("UNPAID") // UNPAID, PENDING, PAID, CANCELLED
  dueDate        DateTime     @map("due_date")
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester       Semester     @relation(fields: [semesterId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]

  @@map("student_invoices")
}

model InvoiceItem {
  id        String         @id @default(uuid())
  invoiceId String         @map("invoice_id")
  name      String         // e.g., 'Biaya SPP / UKT', 'Biaya Lab'
  amount    Decimal        @db.Decimal(12, 2)
  createdAt DateTime       @default(now()) @map("created_at")

  invoice   StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String         @id @default(uuid())
  invoiceId     String         @map("invoice_id")
  paymentMethod String         @map("payment_method") // VA, TRANSFER, QRIS
  referenceNo   String         @unique @map("reference_no")
  amount        Decimal        @db.Decimal(12, 2)
  status        String         @default("PENDING") // PENDING, SUCCESS, FAILED
  isVerified    Boolean        @default(false) @map("is_verified")
  verifiedBy    String?        @map("verified_by")
  paidAt        DateTime?      @map("paid_at")
  payloadJson   String?        @map("payload_json")
  createdAt     DateTime       @default(now()) @map("created_at")

  invoice       StudentInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ==============================================================================
// 9. LEARNING MANAGEMENT SYSTEM (LMS) & EXAMINATIONS
// ==============================================================================

model CourseMaterial {
  id          String      @id @default(uuid())
  classId     String      @map("class_id")
  title       String
  description String?
  fileUrl     String      @map("file_url")
  fileType    String      @map("file_type") // PDF, PPTX, MP4, etc.
  fileSize    Int         @map("file_size")
  order       Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  class       CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("course_materials")
}

model Assignment {
  id          String      @id @default(uuid())
  classId     String      @map("class_id")
  title       String
  description String
  attachmentUrl String?   @map("attachment_url")
  dueDate     DateTime    @map("due_date")
  maxScore    Float       @default(100) @map("max_score")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  class       CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String      @id @default(uuid())
  assignmentId String      @map("assignment_id")
  studentId    String      @map("student_id")
  fileUrl      String      @map("file_url")
  submittedAt  DateTime    @default(now()) @map("submitted_at")
  score        Float?
  feedback     String?
  gradedAt     DateTime?   @map("graded_at")

  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Exam {
  id          String        @id @default(uuid())
  classId     String        @map("class_id")
  title       String
  type        String        // MIDTERM, FINAL, QUIZ
  durationMin Int           @map("duration_min")
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  isRandomized Boolean      @default(true) @map("is_randomized")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  class       CourseClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  attempts    ExamAttempt[]

  @@map("exams")
}

model ExamAttempt {
  id          String      @id @default(uuid())
  examId      String      @map("exam_id")
  studentId   String      @map("student_id")
  startedAt   DateTime    @default(now()) @map("started_at")
  submittedAt DateTime?   @map("submitted_at")
  score       Float?
  isGraded    Boolean     @default(false) @map("is_graded")

  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("exam_attempts")
}

// ==============================================================================
// 10. DIGITAL LIBRARY
// ==============================================================================

model BookCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]

  @@map("book_categories")
}

model Book {
  id          String       @id @default(uuid())
  categoryId  String       @map("category_id")
  isbn        String?      @unique
  title       String
  author      String
  publisher   String?
  publishYear Int?         @map("publish_year")
  isDigital   Boolean      @default(false) @map("is_digital")
  digitalUrl  String?      @map("digital_url")
  totalStock  Int          @default(1) @map("total_stock")
  availableStock Int       @default(1) @map("available_stock")
  coverUrl    String?      @map("cover_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  category    BookCategory @relation(fields: [categoryId], references: [id])
  loans       BookLoan[]

  @@map("books")
}

model LibraryMember {
  id         String     @id @default(uuid())
  userId     String     @unique @map("user_id")
  memberCode String     @unique @map("member_code")
  createdAt  DateTime   @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans      BookLoan[]

  @@map("library_members")
}

model BookLoan {
  id         String        @id @default(uuid())
  bookId     String        @map("book_id")
  memberId   String        @map("member_id")
  borrowDate DateTime      @default(now()) @map("borrow_date")
  dueDate    DateTime      @map("due_date")
  returnDate DateTime?     @map("return_date")
  penaltyFee Decimal       @default(0.00) @map("penalty_fee") @db.Decimal(10, 2)
  status     String        @default("BORROWED") // BORROWED, RETURNED, OVERDUE

  book       Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member     LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("book_loans")
}

// ==============================================================================
// 11. HUMAN RESOURCE MANAGEMENT (HR)
// ==============================================================================

model Employee {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  nip            String    @unique
  position       String
  department     String
  employmentType String    @map("employment_type") // PERMANENT, CONTRACT
  salaryBase     Decimal   @map("salary_base") @db.Decimal(12, 2)
  joinedAt       DateTime  @map("joined_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employees")
}

// ==============================================================================
// 12. FACILITIES, ASSETS & SMART CAMPUS
// ==============================================================================

model Facility {
  id          String   @id @default(uuid())
  campusId    String   @map("campus_id")
  name        String
  type        String   // LAB, AUDITORIUM, SPORTS, ROOM
  capacity    Int?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campus      Campus   @relation(fields: [campusId], references: [id])

  @@map("facilities")
}

// ==============================================================================
// 13. NOTIFICATIONS, MESSAGES & AUDIT TRAILS
// ==============================================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   // ACADEMIC, PAYMENT, LMS, GENERAL
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   // e.g. 'UPDATE_GRADE', 'APPROVE_KRS', 'VERIFY_PAYMENT'
  module    String   // e.g. 'ACADEMIC', 'FINANCE', 'AUTH'
  targetId  String?  @map("target_id")
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Announcement {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  content        String
  category       String   // ACADEMIC, SCHOLARSHIP, EVENT, CAREER, GENERAL
  targetAudience String   @default("ALL") @map("target_audience") // ALL, STUDENTS, LECTURERS
  isPinned       Boolean  @default(false) @map("is_pinned")
  authorName     String   @map("author_name")
  publishedAt    DateTime @default(now()) @map("published_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

